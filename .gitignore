# Source and generated datasets stay local. Curated benchmark evidence is
# versioned under data/benchmark/.
/data/*
!/data/benchmark/
!/data/benchmark/**

# Ad-hoc pipeline runs.
/outputs/

# QuTiP falls back to the working directory when its normal user cache is not
# writable. The solver redirects it to data/.cache/, but ignore the fallback.
/qutip_coeffs_*/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
dist/
build/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
